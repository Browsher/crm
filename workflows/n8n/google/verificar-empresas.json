      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const v=$input.first().json, c=v.criterios;\nfor(const e of v.candidatas) {\n const id=e.google_place_id||('cnpj:'+e.cnpj), b=e.dados_brutos||{};\n const ev=(criterio,opcao,estado,motivo)=>v.evidencias.push({candidata:id,criterio,opcao,estado,motivo,fonte:e.site||e.link_maps||'coleta_google',horario:new Date().toISOString()});\n for(const k of ['site','email']) if(c[k].length===1) {\n  const opcao=c[k][0], valor=e[k];\n  let presente=k==='email'?/^[^\\s@]+@[^\\s@]+$/.test(String(valor||'')):false;\n  if(k==='site'&&valor) { try {const u=new URL(valor); presente=['http:','https:'].includes(u.protocol)&&!/(^|\\.)(instagram|facebook|linkedin|google|whatsapp)\\.(com|net)$/i.test(u.hostname)} catch {} }\n  const confirmado=presente||b[k+'_verificado']===true;\n  if(confirmado) ev(k,opcao,(opcao==='com')===presente?'aprovado':'reprovado','Presença comercial conferida na fonte.');\n  else v.pendencias.push({candidata:id,criterio:k,opcao});\n }\n for(const k of ['produtos','excluir','observacoes']) if(c[k]) v.pendencias.push({candidata:id,criterio:k,opcao:c[k]});\n for(const opcao of c.tipos) v.pendencias.push({candidata:id,criterio:'tipos',opcao});\n if(c.atendimento&&c.atendimento!=='priorizar_fisica') v.pendencias.push({candidata:id,criterio:'atendimento',opcao:c.atendimento});\n}\nif(v.pendencias.length&&!$env.GOOGLE_QUALIFICADOR_URL) throw new Error('Qualificação selecionada ainda não configurada. Preserve o lote.');\nreturn [{json:v}];"
