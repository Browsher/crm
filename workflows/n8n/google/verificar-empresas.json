        "jsCode": "const v=$('Preparar WhatsApp').first().json;\nconst respostas=$input.all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]);\nif(!respostas.length||respostas.some(r=>typeof r.exists!=='boolean'||typeof r.number!=='string')) throw new Error('Resposta WhatsApp não confirmada');\nfor(const e of v.candidatas) if(/^[0-9]{10,11}$/.test(e.telefone||'')) {\n const r=respostas.find(r=>r.number.replace(/\\D/g,'')==='55'+e.telefone);\n v.evidencias.push({candidata:e.google_place_id||('cnpj:'+e.cnpj),criterio:'telefone',opcao:'whatsapp',contato:e.telefone,estado:r?(r.exists?'aprovado':'reprovado'):'nao_confirmado',motivo:r?'Consulta de registro no WhatsApp.':'Número sem confirmação no retorno.',fonte:'evolution_api',horario:new Date().toISOString()});\n}\nreturn [{json:v}];"
