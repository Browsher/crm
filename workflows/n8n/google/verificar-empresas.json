      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const v=$input.first().json, c=v.criterios;\nfor (const e of v.candidatas) {\n const id=e.google_place_id||('cnpj:'+e.cnpj), b=e.dados_brutos||{}, fonte=e.link_maps||b.link||'coleta_google';\n const ev=(criterio,opcao,estado,motivo)=>v.evidencias.push({candidata:id,criterio,opcao:String(opcao),estado,motivo,fonte,horario:new Date().toISOString()});\n for(const [k,campo] of [['nota','review_rating'],['avaliacoes','review_count']]) if(c[k]!==null) {\n  const raw=b[campo]; const n=raw!==undefined&&raw!==null&&String(raw).trim()!==''?Number(raw):NaN;\n  ev(k,c[k],Number.isFinite(n)?(n>=c[k]?'aprovado':'reprovado'):'nao_confirmado',Number.isFinite(n)?'Valor publicado no Google.':'Valor não confirmado pela origem.');\n }\n if(c.situacao&&c.situacao!=='priorizar_funcionamento') {\n  const s=String(e.situacao_google||b.status||'').toLowerCase();\n  const aberto=['operational','open','em funcionamento'].includes(s), temp=['temporarily_closed','temporarily closed'].includes(s), encerrado=['permanently_closed','permanently closed','closed_permanently'].includes(s);\n  const conhecido=aberto||temp||encerrado;\n  const ok=c.situacao==='excluir_encerradas'?!encerrado:aberto;\n  ev('situacao',c.situacao,conhecido?(ok?'aprovado':'reprovado'):'nao_confirmado','Situação informada pela origem Google.');\n }\n}\nreturn [{json:v}];"
      }
    },
