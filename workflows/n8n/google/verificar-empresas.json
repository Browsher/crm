        "jsCode": "const b=$input.first().json.body;\nconst planilha='17uQ8KmuboL808cvb9M9piIhZwCfHYDJRJ5uw2bUAxvU',aba=10151006;\nconst erro=()=>{throw new Error('Planejamento precisa de conferência.');};\nconst uuid=v=>typeof v==='string'&&/^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(v);\nif(!b||typeof b!=='object'||Array.isArray(b)||Buffer.byteLength(JSON.stringify(b),'utf8')>128000||b.protocolo!==1||b.planilha_id!==planilha||b.aba_id!==aba||!['conferir','sincronizar'].includes(b.operacao))erro();\nconst c={...b,base:'https://sheets.googleapis.com/v4/spreadsheets/'+planilha,cabecalho:[\"Pedido ID\",\"Revisão\",\"Vendedor ID\",\"Vendedor\",\"Data\",\"Dia da semana\",\"Nicho\",\"Bairro\",\"Cidade\",\"UF\",\"Situação\",\"Atualizado em\",\"Versão\",\"Critérios de busca\"]};\nif(b.operacao==='sincronizar'){\n const linha=v=>Array.isArray(v)&&[13,14].includes(v.length)&&v.every(x=>typeof x==='string')&&v[0]===b.pedido_id;\n if(!uuid(b.pedido_id)||!uuid(b.envio_id)||!Number.isInteger(b.linha)||b.linha<2||b.linha>200000||!Number.isSafeInteger(b.revisao)||b.revisao<1||!Number.isSafeInteger(b.versao)||b.versao<1||!linha(b.celulas)||b.celulas[1]!==String(b.revisao)||b.celulas[12]!==String(b.versao)||!Array.isArray(b.anteriores)||!b.anteriores.every(linha))erro();\n c.intervalo=\"'Planejamento CRM'!A\"+b.linha+':'+(b.celulas.length===14?'N':'M')+b.linha;\n c.leitura=\"'Planejamento CRM'!A\"+b.linha+':N'+b.linha;\n}\nreturn [{json:c}];"
