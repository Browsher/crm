# Copie para .env.local (desenvolvimento, container do docker-compose.yml).
# A senha de app_conexao é a que você definir com `npm run db:senha -- app_conexao <senha>`.
DATABASE_URL=postgres://app_conexao:<senha-local>@localhost:5432/crm
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/crm
PG_SSL=off
# Limite por pool: padrão 10; na Vercel configurar 2. Ver docs/operacao/producao-vercel.md.
PG_POOL_MAX=10

# Obrigatório para conferir/confirmar importações: 32 bytes aleatórios em 64 caracteres hex.
# Somente no servidor; mesma chave em todas as instâncias. Ver docs/importacao-conferencia.md.
IMPORTACAO_CONFERENCIA_SEGREDO=

# Piloto WhatsApp: configurar apenas no servidor do CRM, nunca com prefixo NEXT_PUBLIC_.
# EVOLUTION_API_URL=https://<dominio-da-evolution>
# EVOLUTION_API_KEY=<chave-global-da-evolution>
# EVOLUTION_INSTANCE_NAME=NTV Box - Suporte
# EVOLUTION_INSTANCE_NAME identifica somente o piloto. Vínculos dos vendedores
# são administrados pelo gestor em /whatsapp/configuracao, no mesmo servidor Evolution.

# Para a Railway, crie .env.railway.local (ignorado pelo git) e rode com ALVO=railway.
# O CA vem do próprio servidor; como extrair e conferir o fingerprint: docs/db/fundacao.md, seção "TLS na Railway".
# DATABASE_URL_ADMIN=postgres://postgres:<senha>@<host>.proxy.rlwy.net:<porta>/railway
# PG_SSL=verify
# PG_SSL_CA=./railway-ca.pem
# PG_SSL_NOME_SERVIDOR=postgres.railway.internal

# Aquisição CNPJ.biz: chave somente no servidor, nunca NEXT_PUBLIC_.
# Limites por vendedor em Empresas -> Busca de empresas. Ver docs/operacao/busca-empresas.md.
CNPJ_BIZ_API_KEY=

# Coordenador Google e espelho da aba Planejamento CRM. Somente no servidor.
GOOGLE_AGENTE_TOKEN=
GOOGLE_AGENTE_USUARIO_ID=
GOOGLE_PLANILHA_ID=
GOOGLE_PLANILHA_ABA_ID=
GOOGLE_PLANILHA_CLIENT_EMAIL=
GOOGLE_PLANILHA_PRIVATE_KEY=

# Alternativa: reutilizar Google OAuth no n8n. Token privado do webhook, não a API key administrativa.
GOOGLE_PLANILHA_N8N_URL=
GOOGLE_PLANILHA_N8N_TOKEN=
GOOGLE_VERIFICACOES_URL=
GOOGLE_VERIFICACOES_TOKEN=
